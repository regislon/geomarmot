{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/regislon/geomarmot/schemas/transformer.schema.json",
  "title": "GeoMarmot transformer (catalogue entry)",
  "description": "A transformer's declaration without its hooks, as the catalogue, the assistant and generated transformers see it. Generated by scripts/build-schemas.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "group",
    "role",
    "summary",
    "description",
    "inputs",
    "outputs",
    "params"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string"
    },
    "group": {
      "enum": [
        "Source",
        "Attributes",
        "Filters",
        "Combine",
        "Reshape",
        "Geometry",
        "Analysis",
        "H3",
        "Output",
        "Custom"
      ]
    },
    "role": {
      "enum": [
        "transform",
        "source",
        "sink"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "whenToUse": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "whenNotToUse": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "params",
          "output"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "params": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputsDependOnParams": {
      "type": "boolean"
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "sql",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "string",
              "number",
              "select",
              "source",
              "column",
              "columns",
              "valuespec",
              "conditions",
              "renames",
              "creates",
              "valuerows",
              "actions",
              "sorts",
              "aggregates",
              "values",
              "rules",
              "joinkeys",
              "choices",
              "sqltext",
              "sqlcreate"
            ]
          },
          "sql": {
            "enum": [
              "none",
              "literal",
              "identifier",
              "expression",
              "query"
            ]
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "description"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "optionsFrom": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            }
          },
          "units": {
            "type": "string"
          },
          "conditional": {
            "type": "boolean"
          }
        }
      }
    },
    "paramsVersion": {
      "type": "integer",
      "minimum": 1
    },
    "aiUsable": {
      "type": "boolean"
    }
  }
}
