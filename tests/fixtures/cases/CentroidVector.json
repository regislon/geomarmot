{
  "transformer": "CentroidVector",
  "cases": [
    {
      "name": "centroid of polygons and lines; attributes ride along",
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "POLYGON ((0 0, 2 0, 2 2, 0 2, 0 0))"],
            [2, "LINESTRING (0 0, 4 0)"],
            [3, "POLYGON ((0 0, 3 0, 3 3, 2 3, 2 1, 1 1, 1 3, 0 3, 0 0))"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "POINT (1 1)"],
            [2, "POINT (2 0)"],
            [3, "POINT (1.5 1.357142857142857)"]
          ]
        }
      }
    },
    {
      "name": "no geometry is an error",
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      },
      "expect": { "error": "needs a geometry column" }
    }
  ]
}
