{
  "transformer": "MinimumConvexHull",
  "cases": [
    {
      "name": "hull of each feature",
      "params": { "scope": "Each feature" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "MULTIPOINT ((0 0), (2 0), (1 1), (1 3))"],
            [2, "POLYGON ((0 0, 3 0, 3 3, 2 3, 2 1, 1 1, 1 3, 0 3, 0 0))"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "POLYGON ((0 0, 1 3, 2 0, 0 0))"],
            [2, "POLYGON ((0 0, 0 3, 3 3, 3 0, 0 0))"]
          ]
        }
      }
    },
    {
      "name": "one hull around the whole layer",
      "params": { "scope": "The whole layer" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "POINT (0 0)"],
            [2, "POINT (4 0)"],
            [3, "POINT (2 3)"],
            [4, "POINT (2 1)"]
          ]
        }
      },
      "geometry": { "mode": "topology", "tolerance": 1e-9, "areaTolerance": 1e-9 },
      "expect": {
        "output": {
          "columns": [
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["POLYGON ((0 0, 2 3, 4 0, 0 0))"]
          ]
        }
      }
    }
  ]
}
