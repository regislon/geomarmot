{
  "transformer": "Aggregator",
  "cases": [
    {
      "name": "groups and computes each aggregate",
      "params": {
        "groupBy": ["cat"],
        "aggregates": [
          { "func": "count", "column": "" },
          { "func": "sum", "column": "v" },
          { "func": "mean", "column": "v", "alias": "avg_v" },
          { "func": "min", "column": "v" },
          { "func": "max", "column": "v" },
          { "func": "median", "column": "v" },
          { "func": "count distinct", "column": "name" }
        ],
        "geometry": "Drop"
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "cat", "type": "VARCHAR" },
            { "name": "count_all", "type": "BIGINT" },
            { "name": "sum_v", "type": "DOUBLE" },
            { "name": "avg_v", "type": "DOUBLE" },
            { "name": "min_v", "type": "DOUBLE" },
            { "name": "max_v", "type": "DOUBLE" },
            { "name": "median_v", "type": "DOUBLE" },
            { "name": "count_distinct_name", "type": "BIGINT" }
          ],
          "rows": [
            ["a", "2", 10.5, 10.5, 10.5, 10.5, 10.5, "2"],
            ["b", "1", 3, 3, 3, 3, 3, "1"],
            [null, "1", 7, 7, 7, 7, 7, "1"],
            ["c", "1", -2, -2, -2, -2, -2, "1"]
          ]
        }
      }
    },
    {
      "name": "no aggregates: counts rows per group",
      "params": {
        "groupBy": ["cat"],
        "aggregates": []
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "cat", "type": "VARCHAR" },
            { "name": "count", "type": "BIGINT" }
          ],
          "rows": [
            [null, "1"],
            ["a", "2"],
            ["b", "1"],
            ["c", "1"]
          ]
        }
      }
    },
    {
      "name": "no grouping: one row for the whole input",
      "params": {
        "groupBy": [],
        "aggregates": [
          { "func": "sum", "column": "v" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "sum_v", "type": "DOUBLE" }
          ],
          "rows": [
            [18.5]
          ]
        }
      }
    },
    {
      "name": "dissolve merges touching squares into one polygon",
      "params": {
        "groupBy": ["cat"],
        "aggregates": [
          { "func": "count", "column": "" }
        ],
        "geometry": "Dissolve"
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "farm", "POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))"],
            [2, "farm", "POLYGON ((1 0, 2 0, 2 1, 1 1, 1 0))"],
            [3, "forest", "POLYGON ((0 1, 1 1, 1 2, 0 2, 0 1))"]
          ]
        }
      },
      "geometry": {
        "mode": "topology",
        "tolerance": 1e-9,
        "areaTolerance": 1e-9,
        "ignore": []
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "cat", "type": "VARCHAR" },
            { "name": "count_all", "type": "BIGINT" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["farm", "2", "POLYGON ((0 0, 0 1, 1 1, 2 1, 2 0, 1 0, 0 0))"],
            ["forest", "1", "POLYGON ((0 1, 1 1, 1 2, 0 2, 0 1))"]
          ]
        }
      }
    }
  ]
}
