    {
      "name": "Add Point across geometry types",
      "params": {
        "mode": "Add Point",
        "x": { "kind": "Value", "type": "Number", "value": "9" },
        "y": { "kind": "Value", "type": "Number", "value": "9" }
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "kind", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["null", null],
            ["point", "POINT (1 1)"],
            ["line", "LINESTRING (0 0, 2 0)"],
            ["polygon", "POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))"],
            ["holed", "POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0), (2 2, 3 2, 3 3, 2 2))"],
            ["multi", "MULTIPOINT ((0 0), (1 1))"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "kind", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["null", "POINT (9 9)"],
            ["point", "LINESTRING (1 1, 9 9)"],
            ["line", "LINESTRING (0 0, 2 0, 9 9)"]
          ]
        },
        "rejected": {
          "columns": [
            { "name": "kind", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" },
            { "name": "rejection_code", "type": "VARCHAR" }
          ],
          "rows": [
            ["polygon", "POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))", "UNSUPPORTED_GEOMETRY_TYPE"],
            ["holed", "POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0), (2 2, 3 2, 3 3, 2 2))", "UNSUPPORTED_GEOMETRY_TYPE"],
            ["multi", "MULTIPOINT (0 0, 1 1)", "UNSUPPORTED_GEOMETRY_TYPE"]
          ]
        }
      }
    },
