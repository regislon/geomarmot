{
  "transformer": "SmoothVectors",
  "cases": [
    {
      "name": "one Chaikin pass",
      "params": { "iterations": "1" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 2 0, 2 2)"],
            [2, "POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 2 0, 2 2)"],
            [2, "POLYGON ((1 0, 3 0, 4 1, 4 3, 3 4, 1 4, 0 3, 0 1, 1 0))"]
          ]
        }
      }
    },
    {
      "name": "two passes double the vertices again",
      "params": { "iterations": "2" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 2 0, 2 2)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 2 0, 2 2)"]
          ]
        }
      }
    }
  ]
}
