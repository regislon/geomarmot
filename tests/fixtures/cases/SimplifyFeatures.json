{
  "transformer": "SimplifyFeatures",
  "cases": [
    {
      "name": "removes vertices within the tolerance",
      "params": { "tolerance": "0.1" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 1 0.05, 2 0, 3 0.04, 4 0)"],
            [2, "POLYGON ((0 0, 2 0, 2 0.01, 2 2, 0 2, 0 0))"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "LINESTRING (0 0, 4 0)"],
            [2, "POLYGON ((0 0, 2 0, 2 2, 0 2, 0 0))"]
          ]
        }
      }
    },
    {
      "name": "a negative tolerance is an error",
      "params": { "tolerance": "-1" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["LINESTRING (0 0, 1 1)"]
          ]
        }
      },
      "expect": { "error": "Tolerance must be a positive number" }
    }
  ]
}
