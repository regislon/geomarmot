{
  "transformer": "DuplicateFilter",
  "cases": [
    {
      "name": "keeps the first of identical rows",
      "params": {
        "keys": ["id", "k"]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "x", "POINT (0 0)"],
            [1, "x", "POINT (0 0)"],
            [2, "y", "POINT (1 1)"],
            [3, "y", "POINT (1 1)"],
            [4, null, null]
          ]
        }
      },
      "expect": {
        "unique": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "x", "POINT (0 0)"],
            [2, "y", "POINT (1 1)"],
            [3, "y", "POINT (1 1)"],
            [4, null, null]
          ]
        },
        "duplicate": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "x", "POINT (0 0)"]
          ]
        }
      }
    },
    {
      "name": "geometry works as a key",
      "params": {
        "keys": ["geometry", "k"]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["x", "POINT (0 0)"],
            ["x", "POINT (0 0)"],
            ["x", "POINT (0 1)"]
          ]
        }
      },
      "expect": {
        "unique": {
          "columns": [
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["x", "POINT (0 0)"],
            ["x", "POINT (0 1)"]
          ]
        },
        "duplicate": {
          "columns": [
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            ["x", "POINT (0 0)"]
          ]
        }
      }
    },
    {
      "name": "no key: everything is unique",
      "params": {
        "keys": []
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "x", "POINT (0 0)"],
            [1, "x", "POINT (0 0)"],
            [2, "y", "POINT (1 1)"],
            [3, "y", "POINT (1 1)"],
            [4, null, null]
          ]
        }
      },
      "expect": {
        "unique": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "x", "POINT (0 0)"],
            [1, "x", "POINT (0 0)"],
            [2, "y", "POINT (1 1)"],
            [3, "y", "POINT (1 1)"],
            [4, null, null]
          ]
        },
        "duplicate": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "k", "type": "VARCHAR" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": []
        }
      }
    }
  ]
}
