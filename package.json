{
  "name": "geomarmot",
  "version": "0.0.0",
  "private": true,
  "description": "Spatial ETL in your browser.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-duckdb-extensions.js && vite build",
    "build:test": "node scripts/fetch-duckdb-extensions.js && vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:browser": "npm run build && npm run build:test && playwright test",
    "check:terms": "node scripts/check-terms.js --tree",
    "check:size": "node scripts/check-size.js",
    "check:docs": "vitest run --config vitest.meta.config.js tests/meta/docs.check.js",
    "check:fixtures": "vitest run --config vitest.meta.config.js tests/meta/fixtures.check.js",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:imports && npm run check:schemas && npm run check:terms && npm run check:size && npm run check:docs && npm run check:fixtures",
    "new-transformer": "node scripts/new-transformer.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:imports": "node scripts/check-imports.js",
    "build:schemas": "vite-node scripts/build-schemas.js",
    "check:schemas": "vite-node scripts/build-schemas.js -- --check",
    "eval": "npm run build && node evals/run.js",
    "build:site": "npm run build && node scripts/build-site.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "marked": "18.0.14",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@duckdb/duckdb-wasm": "1.29.0",
    "h3-js": "4.2.1",
    "jsts": "2.12.1",
    "maplibre-gl": "4.7.1",
    "openai": "7.25.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zarrita": "0.7.5"
  }
}
