{
  "transformer": "SQLTransformer",
  "cases": [
    {
      "name": "any SELECT over input",
      "params": { "sql": "SELECT cat, count(*) AS n FROM input GROUP BY cat" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "cat", "type": "VARCHAR" },
            { "name": "n", "type": "BIGINT" }
          ],
          "rows": [
            [null, "1"],
            ["a", "2"],
            ["b", "1"],
            ["c", "1"]
          ]
        }
      }
    },
    {
      "name": "a trailing semicolon is tolerated",
      "params": { "sql": "SELECT id FROM input WHERE id > 3;" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [4],
            [5]
          ]
        }
      }
    },
    {
      "name": "a query with its own CTE",
      "params": { "sql": "WITH big AS (SELECT * FROM input WHERE v > 5) SELECT id FROM big" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [1],
            [4]
          ]
        }
      }
    },
    {
      "name": "an empty query passes rows through",
      "params": { "sql": "" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      }
    },
    {
      "name": "a broken query is an error",
      "params": { "sql": "SELECT nope FROM input" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      },
      "expect": { "error": "nope" }
    }
  ]
}
