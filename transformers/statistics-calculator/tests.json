{
  "transformer": "StatisticsCalculator",
  "cases": [
    {
      "name": "summary per group and every row with its group's statistics",
      "params": {
        "groupBy": ["cat"],
        "attributes": ["v"],
        "stats": ["Sum", "Mean", "Minimum", "Maximum", "Standard deviation", "Standard deviation (population)", "Median", "Range", "Mode", "Total count", "Numeric count", "Value count"]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "error": "Binder Error: column \"id\" must appear in the GROUP BY clause or must be part of an aggregate function.\nEither add it to the GROUP BY list, or use \"ANY_VALUE(id)\" if the exact value of \"id\" is not important."
      }
    },
    {
      "name": "no grouping: whole-table statistics",
      "params": {
        "groupBy": [],
        "attributes": ["v", "id"],
        "stats": ["Sum", "Mean"]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "summary": {
          "columns": [
            { "name": "v_sum", "type": "DOUBLE" },
            { "name": "v_mean", "type": "DOUBLE" },
            { "name": "id_sum", "type": "HUGEINT" },
            { "name": "id_mean", "type": "DOUBLE" }
          ],
          "rows": [
            [18.5, 4.625, "15", 3]
          ]
        },
        "complete": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" },
            { "name": "v_sum", "type": "DOUBLE" },
            { "name": "v_mean", "type": "DOUBLE" },
            { "name": "id_sum", "type": "HUGEINT" },
            { "name": "id_mean", "type": "DOUBLE" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)", 18.5, 4.625, "15", 3],
            [2, "Bo", "b", 3, "POINT (1 1)", 18.5, 4.625, "15", 3],
            [3, "Cy", "a", null, "POINT (2 2)", 18.5, 4.625, "15", 3],
            [4, "Di", null, 7, null, 18.5, 4.625, "15", 3],
            [5, "Eve", "c", -2, "POINT (3 3)", 18.5, 4.625, "15", 3]
          ]
        }
      }
    },
    {
      "name": "no attributes: a row count",
      "params": {
        "groupBy": ["cat"],
        "attributes": [],
        "stats": ["Sum"]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "summary": {
          "columns": [
            { "name": "cat", "type": "VARCHAR" },
            { "name": "count", "type": "BIGINT" }
          ],
          "rows": [
            [null, "1"],
            ["a", "2"],
            ["b", "1"],
            ["c", "1"]
          ]
        },
        "complete": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" },
            { "name": "count", "type": "BIGINT" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)", "2"],
            [3, "Cy", "a", null, "POINT (2 2)", "2"],
            [5, "Eve", "c", -2, "POINT (3 3)", "1"],
            [4, "Di", null, 7, null, "1"],
            [2, "Bo", "b", 3, "POINT (1 1)", "1"]
          ]
        }
      }
    }
  ]
}
