{
  "transformer": "Sorter",
  "cases": [
    {
      "name": "sorts by one attribute descending, then by another ascending",
      "params": {
        "sorts": [
          { "column": "cat", "direction": "DESC" },
          { "column": "id", "direction": "ASC" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "ordered": true,
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [5, "Eve", "c", -2, "POINT (3 3)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null]
          ]
        }
      }
    },
    {
      "name": "no sort keys keeps rows",
      "params": {
        "sorts": []
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [2],
            [1]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [2],
            [1]
          ]
        }
      }
    }
  ]
}
