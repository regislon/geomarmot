            [46, "r46"],
            [47, "r47"],
            [48, "r48"],
            [49, "r49"],
            [50, "r50"]
          ]
        }
      },
      "assert": {
        "rowCount": { "min": 3, "max": 47 },
        "subsetOf": "input",
        "columnsEqual": "input",
        "unique": ["id"]
      }
    },
    {
