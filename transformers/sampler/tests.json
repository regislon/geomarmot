{
  "transformer": "Sampler",
  "cases": [
    {
      "name": "first N",
      "params": { "mode": "First N", "amount": "3" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [1],
            [2],
            [3],
            [4],
            [5]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [1],
            [2],
            [3]
          ]
        }
      }
    },
    {
      "name": "every Nth",
      "params": { "mode": "Every Nth", "amount": "2" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [1],
            [2],
            [3],
            [4],
            [5]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" }
          ],
          "rows": [
            [2],
            [4]
          ]
        }
      }
    },
    {
      "name": "random 50% returns a subset of the input rows",
      "params": { "mode": "Random %", "amount": "50" },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "s", "type": "VARCHAR" }
