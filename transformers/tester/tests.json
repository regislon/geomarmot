    {
      "name": "AND of two conditions; NULL goes to failed",
      "params": {
        "logic": "AND",
        "conditions": [
          { "column": "cat", "operator": "=", "value": "a" },
          { "column": "v", "operator": ">", "value": "5" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "passed": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
