{
  "transformer": "AreaOnAreaOverlayer",
  "cases": [
    {
      "name": "splits two overlapping squares into three faces, counting and accumulating",
      "params": {
        "accumulate": [
          "cat"
        ],
        "separator": ";"
      },
      "inputs": {
        "input": {
          "columns": [
            {
              "name": "id",
              "type": "INTEGER"
            },
            {
              "name": "cat",
              "type": "VARCHAR"
            },
            {
              "name": "geometry",
              "type": "GEOMETRY"
            }
          ],
          "rows": [
            [
              1,
              "A",
              "POLYGON ((0 0, 2 0, 2 2, 0 2, 0 0))"
            ],
            [
              2,
              "B",
              "POLYGON ((1 1, 3 1, 3 3, 1 3, 1 1))"
            ],
            [
              3,
              "C",
              "POLYGON ((10 10, 11 10, 11 11, 10 11, 10 10))"
            ]
          ]
        }
      },
      "geometry": {
        "mode": "topology",
        "tolerance": 1e-09,
        "areaTolerance": 1e-09
      },
      "expect": {
        "output": {
          "columns": [
            {
              "name": "geometry",
              "type": "GEOMETRY"
            },
            {
              "name": "_overlaps",
              "type": "BIGINT"
            },
            {
              "name": "cat",
              "type": "VARCHAR"
            }
          ],
          "rows": [
            [
              "POLYGON ((2 1, 2 0, 0 0, 0 2, 1 2, 1 1, 2 1))",
              "1",
              "A"
            ],
            [
              "POLYGON ((1 2, 2 2, 2 1, 1 1, 1 2))",
              "2",
              "A;B"
            ],
            [
              "POLYGON ((2 1, 2 2, 1 2, 1 3, 3 3, 3 1, 2 1))",
              "1",
              "B"
            ],
            [
              "POLYGON ((10 10, 10 11, 11 11, 11 10, 10 10))",
              "1",
              "C"
            ]
          ]
        }
      }
    },
    {
      "name": "custom overlap count name and separator",
      "params": {
        "countAttribute": "depth",
        "accumulate": [
          "cat",
          "id"
        ],
        "separator": "|"
      },
      "inputs": {
        "input": {
          "columns": [
            {
              "name": "id",
              "type": "INTEGER"
            },
            {
              "name": "cat",
