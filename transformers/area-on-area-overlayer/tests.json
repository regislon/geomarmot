            ],
            [
              3,
              "C",
              "POLYGON ((10 10, 11 10, 11 11, 10 11, 10 10))"
            ]
          ]
        }
      },
      "geometry": {
        "mode": "topology",
        "tolerance": 1e-09,
        "areaTolerance": 1e-09
      },
      "expect": {
        "output": {
          "columns": [
            {
              "name": "geometry",
              "type": "GEOMETRY"
            },
            {
              "name": "depth",
              "type": "BIGINT"
            },
            {
              "name": "cat",
              "type": "VARCHAR"
            },
            {
              "name": "id",
              "type": "VARCHAR"
            }
          ],
          "rows": [
            [
              "POLYGON ((2 1, 2 0, 0 0, 0 2, 1 2, 1 1, 2 1))",
              "1",
              "A",
              "1"
            ],
            [
              "POLYGON ((1 2, 2 2, 2 1, 1 1, 1 2))",
              "2",
              "A|B",
              "1|2"
            ],
            [
              "POLYGON ((2 1, 2 2, 1 2, 1 3, 3 3, 3 1, 2 1))",
              "1",
              "B",
              "2"
            ],
            [
              "POLYGON ((10 10, 10 11, 11 11, 11 10, 10 10))",
              "1",
              "C",
              "3"
            ]
          ]
        }
      }
    },
