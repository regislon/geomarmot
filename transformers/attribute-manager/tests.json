{
  "transformer": "AttributeManager",
  "cases": [
    {
      "name": "applies set, rename, copy, create and remove in order",
      "params": {
        "actions": [
          {
            "action": "Set value",
            "column": "v",
            "spec": { "kind": "Value", "type": "Number", "value": "0" }
          },
          { "action": "Rename", "column": "name", "target": "who" },
          { "action": "Copy to", "column": "who", "target": "who_copy" },
          {
            "action": "Create",
            "target": "twice",
            "spec": {
              "kind": "Formula",
              "left": { "kind": "Attribute", "column": "id" },
              "operator": "×",
              "right": { "kind": "Value", "type": "Number", "value": "2" }
            }
          },
          { "action": "Remove", "column": "cat" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "who", "type": "VARCHAR" },
            { "name": "v", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" },
            { "name": "who_copy", "type": "VARCHAR" },
            { "name": "twice", "type": "INTEGER" }
          ],
          "rows": [
            [1, "Ada", 0, "POINT (0 0)", "Ada", 2],
            [2, "Bo", 0, "POINT (1 1)", "Bo", 4],
            [3, "Cy", 0, "POINT (2 2)", "Cy", 6],
            [4, "Di", 0, null, "Di", 8],
            [5, "Eve", 0, "POINT (3 3)", "Eve", 10]
          ]
        }
      }
    },
    {
      "name": "order matters: rename then set the new name",
      "params": {
        "actions": [
          { "action": "Rename", "column": "v", "target": "w" },
          {
            "action": "Set value",
            "column": "w",
            "spec": { "kind": "SQL", "sql": "id * 100" }
          }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 10.5, "POINT (0 0)"],
            [2, "Bo", "b", 3, "POINT (1 1)"],
            [3, "Cy", "a", null, "POINT (2 2)"],
            [4, "Di", null, 7, null],
            [5, "Eve", "c", -2, "POINT (3 3)"]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "name", "type": "VARCHAR" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "w", "type": "INTEGER" },
            { "name": "geometry", "type": "GEOMETRY" }
          ],
          "rows": [
            [1, "Ada", "a", 100, "POINT (0 0)"],
            [2, "Bo", "b", 200, "POINT (1 1)"],
            [3, "Cy", "a", 300, "POINT (2 2)"],
            [4, "Di", null, 400, null],
            [5, "Eve", "c", 500, "POINT (3 3)"]
          ]
        }
      }
    },
    {
      "name": "convert changes a type; a value that does not convert becomes empty",
      "params": {
        "actions": [
          { "action": "Convert", "column": "v", "to": "Integer" },
          { "action": "Convert", "column": "cat", "to": "Decimal" },
          { "action": "Convert", "column": "id", "to": "Text" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "cat", "type": "VARCHAR" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, "2.5", 10.4],
            [2, "x", 3],
            [3, null, null]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "VARCHAR" },
            { "name": "cat", "type": "DOUBLE" },
            { "name": "v", "type": "BIGINT" }
          ],
          "rows": [
            ["1", 2.5, "10"],
            ["2", null, "3"],
            ["3", null, null]
          ]
        }
      }
    },
    {
      "name": "an edit on a column that does not exist is skipped",
      "params": {
        "actions": [
          {
            "action": "Set value",
            "column": "missing",
            "spec": { "kind": "Value", "type": "Number", "value": "1" }
          },
          { "action": "Remove", "column": "nope" }
        ]
      },
      "inputs": {
        "input": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      },
      "expect": {
        "output": {
          "columns": [
            { "name": "id", "type": "INTEGER" },
            { "name": "v", "type": "DOUBLE" }
          ],
          "rows": [
            [1, 2]
          ]
        }
      }
    }
  ]
}
